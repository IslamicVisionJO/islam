{
  "name": "tahadi-tawjihi-islamic",
  "version": "2.4.3",
  "private": true,
  "description": "منصة تحدي التوجيهي — حسابات إيميل وتقدم محفوظ ومواجهات أونلاين بالغرف",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:review": "node scripts/build.mjs --review",
    "start:review": "node scripts/serve.mjs --review",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:content-upgrade": "node --test supabase/tests/steam-achievements.test.mjs supabase/tests/textbook-seeds.test.mjs && node tests/content-upgrade.spec.mjs",
    "test:wall": "node --test tests/wall-rules.test.mjs supabase/tests/wall-challenge.test.mjs supabase/tests/wall-matches.test.mjs tests/wall-ui.spec.mjs",
    "test:browser": "node tests/browser.spec.mjs",
    "check": "npm run build && npm test && npm run test:browser && npm run test:auth && npm run test:online:sql && npm run test:online:browser && npm run test:background && npm run test:games && npm run test:games:online && npm run test:sql-editor && npm run test:learning && npm run test:study && npm run test:million && npm run test:scenes && npm run test:knowledge && npm run test:qr && npm run test:content-upgrade && npm run test:wall",
    "test:auth": "node tests/auth-ui.spec.mjs",
    "test:online:sql": "node --test supabase/tests/online-duels.test.mjs",
    "test:online:browser": "node tests/online-ui.spec.mjs",
    "test:background": "node tests/background-ui.spec.mjs",
    "test:games": "node --test tests/educational-content.test.mjs && node tests/educational-ui.spec.mjs && node tests/educational-lifecycle.spec.mjs",
    "test:games:online": "node --test supabase/tests/educational-online.test.mjs && node tests/educational-online-ui.spec.mjs && node tests/educational-online-edge.spec.mjs",
    "test:sql-editor": "node --test supabase/tests/sql-editor-install.test.mjs && node tests/sql-editor-guide.spec.mjs",
    "test:learning": "node --test tests/learning.test.mjs && node tests/learning-ui.spec.mjs && node tests/learning-rewards.spec.mjs",
    "test:scenes": "node tests/scenes.spec.mjs && node tests/scene-interactions.spec.mjs",
    "test:study": "node --test tests/study-content.test.mjs && node tests/study-ui.spec.mjs",
    "test:million": "node --test tests/million-policy.test.mjs supabase/tests/million-rewards.test.mjs && node tests/million-ui.spec.mjs",
    "test:knowledge": "node --test supabase/tests/knowledge.test.mjs && node tests/knowledge-ui.spec.mjs",
    "test:qr": "node tests/site-qr.spec.mjs"
  },
  "engines": {
    "node": ">=22.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "playwright": "1.62.1",
    "qrcode": "1.5.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
